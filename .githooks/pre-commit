#!/usr/bin/env bash
#
# Форматирование всего проекта перед коммитом.
#
# ПОЧЕМУ ХУК, А НЕ ШАГ В CI. Проверка формата в CI — это сообщение о том, что
# коммит уже сделан неправильно: конвейер краснеет через несколько минут после
# push, на ветке, которую уже видят другие, и лечится отдельным коммитом «fmt».
# Автокоммит из CI лечит симптом дороже болезни — он требует прав на запись
# в репозиторий, оставляет на main коммиты, которых никто не писал, и гоняется
# с параллельными push. Хук устраняет причину: до коммита неотформатированного
# кода просто не доходит.
#
# Проверка в CI при этом остаётся и обязана оставаться: хук живёт на машине
# разработчика, его можно не поставить и можно обойти через --no-verify.
#
# ПИШЕТСЯ ПОД BASH 3.2. На macOS /bin/bash — именно он, и mapfile, readarray
# и ассоциативные массивы там отсутствуют. Хук, падающий на машине автора,
# не защищает ничего: первая же версия этого файла молча не сработала.
#
# Установка: make hooks
set -euo pipefail

command -v gofmt >/dev/null || {
  echo "pre-commit: gofmt не найден, пропускаю форматирование" >&2
  exit 0
}

# Ровно та же команда, что и в CI, — иначе хук будет считать проект
# отформатированным там, где конвейер считает иначе.
unformatted="$(gofmt -l . 2>/dev/null || true)"
[ -n "$unformatted" ] || exit 0

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"

restaged=""
leftover=""
old_ifs="$IFS"
IFS='
'
for file in $unformatted; do
  gofmt -w "$file"
  # Проиндексированный файл возвращается в индекс: без этого в коммит уедет
  # неотформатированная версия, а исправление останется в рабочем дереве.
  if printf '%s\n' "$staged" | grep -qxF -- "$file"; then
    git add -- "$file"
    restaged="$restaged  $file
"
  else
    # Чужой файл в коммит не добавляется: `git add` втащил бы сюда правку,
    # которой автор здесь не планировал. Но сообщить обязательно — CI
    # проверяет всё дерево, а не только коммит.
    leftover="$leftover  $file
"
  fi
done
IFS="$old_ifs"

[ -n "$restaged" ] && printf 'pre-commit: отформатировано и возвращено в индекс:\n%s' "$restaged"
if [ -n "$leftover" ]; then
  printf 'pre-commit: отформатировано, но НЕ добавлено в этот коммит:\n%s' "$leftover" >&2
  echo "pre-commit: закоммитьте их отдельно, иначе CI покраснеет на следующем push" >&2
fi

exit 0
