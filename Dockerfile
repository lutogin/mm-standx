# Сборка обоих бинарей: торгующего процесса и сторожа.
#
# Сторож обязан быть отдельным процессом и жить в отдельном контейнере: он
# существует ровно для того случая, когда торгующий процесс умер. Собираются
# они из одного дерева, поэтому образ общий, а роль выбирается командой.

FROM golang:1.26-alpine AS build

WORKDIR /src

# Зависимости отдельным слоем: они меняются заметно реже исходников,
# и пересобирать их на каждую правку кода незачем.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO выключен: бинарь получается статическим и не зависит от библиотек
# базового образа. -trimpath убирает пути сборочной машины из бинаря.
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mmbot    ./cmd/mmbot && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/guardian ./cmd/guardian && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/standxctl ./cmd/standxctl

# --- Рабочий образ ---
#
# Alpine, а не distroless, сознательно: в контейнере с торгующим ботом рано
# или поздно придётся разбираться на месте, и наличие оболочки экономит часы.
# Плата за это — доступная оболочка в образе, который держит доступ к счёту,
# поэтому процесс не root и файловая система пишется только в /app/data.
FROM alpine:3.21

# Сертификаты нужны для TLS до биржи, tzdata — чтобы время в логах было UTC,
# а не «локальным временем контейнера», которого не существует.
RUN apk add --no-cache ca-certificates tzdata curl && \
    adduser -D -u 10001 -h /app mmbot

WORKDIR /app
COPY --from=build /out/mmbot /out/guardian /out/standxctl /usr/local/bin/

# Коммит, из которого собран образ.
#
# ARG VERSION до этого объявлялся в сборочной стадии и не использовался нигде:
# ни в ldflags, ни в лейбле. Образ не помнил, откуда он, и «доехала ли правка»
# приходилось выводить из тега на сервере — то есть из того самого места,
# ошибку в котором вопрос и должен был обнаружить.
#
# ARG объявляется повторно намеренно: он действует в пределах одной стадии.
# Лейбл читается на сервере без запуска контейнера:
#   docker inspect lutogin/mm-standx:latest \
#     --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
ARG VERSION=dev
LABEL org.opencontainers.image.revision="$VERSION"
LABEL org.opencontainers.image.source="https://github.com/lutogin/mm-standx"

# Конфигурация в образ НЕ кладётся: она подключается томом в /app/config.
#
# Запечённый в образ файл означал, что правка любого порога стоит пересборки
# и публикации образа, а действующее значение приходится выводить из того,
# какой тег на сервере. Каталог смонтирован — параметр правится на месте
# и применяется перезапуском контейнера.
#
# Монтируется именно КАТАЛОГ, а не файл, и это не косметика. Одиночный файл
# Docker привязывает по иноду: редактор, который пишет через временный файл
# и переименование (vim, sed -i), оставляет контейнеру старое содержимое,
# и правка «не применяется» без единого сообщения об ошибке. Вторая ловушка
# там же: если файла нет на хосте, Docker молча создаёт на его месте пустой
# КАТАЛОГ, и процесс падает на «is a directory» — на той машине, где файла
# не оказалось, то есть в проде.
#
# Каталог создаётся заранее и пустым: том, смонтированный поверх, наследует
# владельца точки монтирования.

# Каталоги состояния создаются заранее и принадлежат непривилегированному
# пользователю по той же причине.
RUN mkdir -p /app/config /app/data /app/data/state /app/data/stats && chown -R mmbot:mmbot /app

USER mmbot

# Время внутри контейнера — UTC. Начисление биржа считает по календарным
# часам UTC, и расхождение часовых поясов в логах стоило бы часа разбирательств
# при первом же несовпадении с отчётом.
ENV TZ=UTC

# Метрики и проба живости. Наружу порт не публикуется — см. docker-compose.yml.
EXPOSE 9090

ENTRYPOINT ["mmbot"]
CMD ["-config", "/app/config/config.yaml"]
