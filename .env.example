# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
#
#   cp .env.example .env && chmod 600 .env
#
# Приватный ключ принимается ТОЛЬКО отсюда. Попытка задать его в config.yaml
# приведёт к отказу загрузки конфигурации.

# Приватный ключ кошелька BSC, с префиксом 0x или без него.
#
# Заводите под бота отдельный кошелёк и держите на нём только рабочую сумму.
# Ключ нужен лишь для выпуска токена доступа: торговые запросы подписывает
# эфемерный ключ сессии, который сохраняется в data/session.json вместе
# с токеном. Пока токен действует, эту переменную можно не задавать вовсе —
# бот поднимется из сохранённой сессии.
STANDX_WALLET_PK=

# Любой параметр config.yaml переопределяется переменной с префиксом MMSTANDX_.
# Имя собирается из пути к ключу: runtime.logLevel → MMSTANDX_RUNTIME_LOGLEVEL.
#
# Значения в config.yaml — это версионированное решение с объяснением, почему
# порог именно такой. Значения здесь — то, что отличает конкретный запуск
# и должно меняться без пересборки образа.
#
# Действующие значения всегда можно спросить у работающего процесса, а не
# выводить из того, какой образ на сервере:
#
#   docker compose logs mmbot | grep "risk limits in force"
#   curl -s localhost:9090/metrics | grep mm_risk_limit

# Какие инструменты торговать. Один файл конфигурации едет на все машины,
# а решение принимается при запуске.
# MMSTANDX_RUNTIME_SYMBOLS=XAU-USD

# Режим. По умолчанию dry_run: включать торговлю нужно осознанно.
# MMSTANDX_RUNTIME_MODE=live

# MMSTANDX_RUNTIME_LOGLEVEL=debug
# MMSTANDX_RUNTIME_METRICSADDR=127.0.0.1:9090

# --- Размер и пределы риска ---
#
# Задаются здесь, потому что зависят от депозита конкретного счёта, а он
# меняется чаще, чем стратегия. Значения в config.yaml рассчитаны на 60 USD
# калибровочной аллокации; при её изменении пределы обязаны поехать следом.
#
# Ориентир: полный залив лесенки стоит примерно 5 bps нотионала стороны,
# то есть 0.1 USD на каждые 100 USD аллокации при плече 4. Дневной предел,
# оставленный от прежнего размера, взводит остановку на первых же заливах
# и не даёт набрать статистику.
#
#   аллокация   один свип   разумный maxDailyLossUsd
#         100      0.10 USD      ~10
#        1000      1.00 USD      ~60
#       10000     10.00 USD     ~350

# Аллокация на инструмент. Имя символа пишется через подчёркивание: XAU-USD →
# XAU_USD. Дефис в имени переменной этот файл не переживёт — разбор отвергнет
# его целиком, вместе со всеми остальными строками.
# MMSTANDX_SYMBOLS_XAU_USD_ALLOCATIONUSD=1000

# Внешний ориентир по инструменту. Выключается, пока не измерено, сколько
# упреждения он реально даёт (PLAN.md §12.15); бот при этом продолжает работать
# на прежнем быстром сигнале — смещении середины стакана.
# MMSTANDX_SYMBOLS_XAU_USD_REFERENCE_ENABLED=false

# Дневной убыток, после которого торговля прекращается до вмешательства
# человека. Считается по худшей из двух оценок: данных биржи и модели
# стоимости. Взведённая остановка переживает перезапуск.
# MMSTANDX_RISK_MAXDAILYLOSSUSD=60

# Потолок суммарного нотионала, проверяется при запуске: сумма
# allocationUsd x leverage по включённым инструментам не должна его превышать.
# Поднимать вместе с аллокацией, иначе процесс не поднимется.
# MMSTANDX_RISK_MAXNOTIONALUSD=120000

# Детектор рассогласования модели с рынком, а не денежный лимит: стратегия
# построена на том, что исполнения редки.
# MMSTANDX_RISK_MAXFILLSPERHOUR=20

# --- Запуск ---
#
# Эти две переменные читает docker-compose.yml и передаёт боту. Всё остальное
# берётся из config.yaml.

# Режим: dry_run — полный цикл, но ордера на биржу не уходят; live — реальные
# ордера. Значение по умолчанию dry_run: включать торговлю нужно осознанно.

MM_MODE=dry_run

# Какие инструменты торговать, через запятую. Золото выбрано по измерениям
# 3–5 августа: см. docs/ab-appetite-2026-08-05.md.
MM_SYMBOLS=XAU-USD

# Порт метрик на хосте (только петля). Меняется при коллизии.
# MM_METRICS_PORT=9090
