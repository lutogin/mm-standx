# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
#
#   cp .env.example .env && chmod 600 .env
#
# Здесь живут ровно две вещи, и обе — не настройки стратегии: приватный ключ
# и режим работы. Всё остальное описано в config/config.yaml и задаётся только
# там: инструменты, аллокация, пределы риска, пороги дистанций.
#
# Переменных MMSTANDX_* больше не существует. Если такая строка осталась
# здесь или на сервере, она не делает ничего, а процесс называет её при старте
# отдельной строкой лога:
#
#   docker compose logs mmbot | grep "removed override layer"
#
# Действующие значения всегда можно спросить у работающего процесса, а не
# выводить из того, какой образ на сервере:
#
#   docker compose logs mmbot | grep "risk limits in force"
#   curl -s localhost:9090/metrics | grep mm_risk_limit

# Приватный ключ кошелька BSC, с префиксом 0x или без него.
#
# Заводите под бота отдельный кошелёк и держите на нём только рабочую сумму.
# Ключ нужен лишь для выпуска токена доступа: торговые запросы подписывает
# эфемерный ключ сессии, который сохраняется в data/session.json вместе
# с токеном. Пока токен действует, эту переменную можно не задавать вовсе —
# бот поднимется из сохранённой сессии.
#
# Задать его в config/config.yaml нельзя: поле помечено как не читаемое
# из файла, и попытка приведёт к отказу загрузки.
STANDX_WALLET_PK=

# Режим: dry_run — полный цикл, но ордера на биржу не уходят; live — реальные
# ордера. Незаданная переменная означает dry_run: торговля включается осознанным
# действием, а не тем, что кто-то забыл что-то выставить.
#
# В config/config.yaml не принимается намеренно. Файл версионируется и одинаков
# везде, где его запускают, поэтому строка `mode: live` в нём означала бы, что
# любой локальный прогон на машине с рабочим ключом отправляет настоящие ордера.
#
# Разовый теневой прогон, не трогая этот файл: make run MM_MODE=dry_run
MM_MODE=live

# Предохранитель дымового теста с настоящими ордерами (make test-live).
# Не конфигурация бота: его читает Makefile, а не процесс.
# STANDX_LIVE=1
