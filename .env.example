# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
#
#   cp .env.example .env && chmod 600 .env
#
# Приватный ключ принимается ТОЛЬКО отсюда. Попытка задать его в config.yaml
# приведёт к отказу загрузки конфигурации.

# Приватный ключ кошелька BSC, с префиксом 0x или без него.
#
# Заводите под бота отдельный кошелёк и держите на нём только рабочую сумму.
# Ключ нужен лишь для выпуска токена доступа: торговые запросы подписывает
# эфемерный ключ сессии, который сохраняется в data/session.json вместе
# с токеном. Пока токен действует, эту переменную можно не задавать вовсе —
# бот поднимется из сохранённой сессии.
STANDX_WALLET_PK=

# Любой параметр config.yaml переопределяется переменной с префиксом MMSTANDX_.
# Имя собирается из пути к ключу: runtime.logLevel → MMSTANDX_RUNTIME_LOGLEVEL.
#
# Переопределять здесь имеет смысл то, что зависит от машины и от запуска,
# а не от стратегии. Пороги риска и параметры котирования живут в config.yaml,
# потому что они обсуждаются, версионируются и объясняются комментариями.

# Какие инструменты торговать. Один файл конфигурации едет на все машины,
# а решение принимается при запуске.
# MMSTANDX_RUNTIME_SYMBOLS=XAU-USD

# Режим. По умолчанию dry_run: включать торговлю нужно осознанно.
# MMSTANDX_RUNTIME_MODE=live

# MMSTANDX_RUNTIME_LOGLEVEL=debug
# MMSTANDX_RUNTIME_METRICSADDR=127.0.0.1:9090

# --- Запуск ---
#
# Эти две переменные читает docker-compose.yml и передаёт боту. Всё остальное
# берётся из config.yaml.

# Режим: dry_run — полный цикл, но ордера на биржу не уходят; live — реальные
# ордера. Значение по умолчанию dry_run: включать торговлю нужно осознанно.

MM_MODE=dry_run

# Какие инструменты торговать, через запятую. Золото выбрано по измерениям
# 3–5 августа: см. docs/ab-appetite-2026-08-05.md.
MM_SYMBOLS=XAU-USD
